{
  "name": "finguard-client",
  "version": "0.1.0",
  "private": true,
  "description": "FinGuard client prototype (Phase 1): sample data and a mock engine only. It never decides affordability.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "node scripts/check-integrity.mjs && eslint .",
    "lint:integrity": "node scripts/check-integrity.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:logic": "tsc --noEmit -p tsconfig.logic.json",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}
