# Copy to .env.local (git-ignored). Only VITE_-prefixed variables reach browser code: never put a secret in one.
# These are read at dev-server start / build time, and the production CSP is generated from the same values.

# "mock" (default): committed sample results, no network, CSP connect-src 'none'.
# "live": call the local FinGuard API. Requires VITE_API_BASE_URL.
VITE_FINGUARD_MODE=mock

# Used only when VITE_FINGUARD_MODE=live. Must be a loopback origin with an explicit port, no path:
# http://127.0.0.1:8000, http://localhost:8000 or http://[::1]:8000. Anything else fails the build.
# The server must list this page's origin in FINGUARD_CORS_ORIGINS (dev: http://localhost:5173).
# VITE_API_BASE_URL=http://127.0.0.1:8000
