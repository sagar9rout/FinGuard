# Copy to .env if you use a tool that loads it; the server itself reads only the process environment.
# Nothing here is a secret. No database variable exists: this phase has no persistence.
FINGUARD_SERVER_HOST=127.0.0.1
FINGUARD_SERVER_PORT=8000
# The Vite dev server (client/vite.config.ts binds localhost; Vite's default port is 5173). Leave empty to disable CORS.
FINGUARD_CORS_ORIGINS=http://localhost:5173
FINGUARD_MAX_BODY_BYTES=1048576
FINGUARD_LOG_LEVEL=INFO
# Directory containing finguard_api and finguard_core; defaults to ../backend.
# FINGUARD_BACKEND_PATH=../backend
